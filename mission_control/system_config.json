{
    "nodes": {
        "agx1": {
            "ip": "192.168.131.22",
            "agent_port": 6000
        },
        "nano": {
            "ip": "192.168.131.21",
            "agent_port": 6000
        },
        "agx2": {
            "ip": "192.168.131.23",
            "agent_port": 6000
        },
        "laptop": {
            "ip": "localhost",
            "agent_port": 6000
        }
    },
    "services": [
        {
            "id": "vila_api",
            "node": "agx1",
            "command": "python3 -m nano_llm.chat --api=mlc --model Efficient-Large-Model/VILA1.5-3b --max-context-len 256 --max-new-tokens 32 --save-json-by-image --server --port 8080 --notify-url http://192.168.131.22:5050/from_vila",
            "cwd": "/home/user/jetson-containers",
            "description": "VILA 1.5 API Server"
        },
        {
            "id": "nanoowl",
            "node": "agx1",
            "command": "python3 nanoowl_service.py --engine /opt/nanoowl/data/owl_image_encoder_patch32.engine --host 0.0.0.0 --port 5060 --min-score 0.2",
            "cwd": "/home/user/examples/jetson_server",
            "description": "NanoOWL Object Detector"
        },
        {
            "id": "comm_manager",
            "node": "agx1",
            "command": "python3 comm_manager.py --host 0.0.0.0 --port 5050 --jetson2-endpoint http://192.168.131.21:5050/prompts --captures-root/home/user/jetson-containers/data/R2/ --nanoowl-endpoint http://192.168.131.22:5060/infer --forward-timeout 45 --forward-retries 3 --nanoowl-timeout 70 --nanoowl-annotate 0 --forward-json-url http://192.168.131.23:9090/ingest",
            "cwd": "/home/user/GIT/NanoLLM_VILA_and_OWL",
            "description": "Orchestrates VILA -> Jetson2 -> NanoOWL"
        },
        {
            "id": "display_server",
            "node": "agx1",
            "command": "python3 display_server.py --root /home/user/jetson-containers/data/R2 --host 0.0.0.0 --port 8090 --latest-only",
            "cwd": "/home/user/GIT/NanoLLM_VILA_and_OWL",
            "description": "Web GUI for results on AGX1"
        },
        {
            "id": "vlm_backfill",
            "node": "agx1",
            "command": "python3 vlm_backfill_latest.py --base-dir /home/user/jetson-containers/data/R2 --endpoint http://192.168.131.22:8080/describe --watch-interval 5.0 --sleep-between 20 --timeout 60",
            "cwd": "/home/user/rqs_iai_ws/src/examples/src",
            "description": "Trigger VILA processing for new images"
        },
        {
            "id": "prompt_converter",
            "node": "nano",
            "command": "gunicorn -w 1 -k gthread --threads 8 --timeout 120 -b 0.0.0.0:5050 prompt_converter_llm_v2:app",
            "cwd": "/home/user/GIT/NanoLLM_VILA_and_OWL/LLM",
            "description": "LLM text parser on Jetson Nano"
        },
        {
            "id": "ollama",
            "node": "agx2",
            "command": "ollama serve",
            "cwd": "/home/nvidia",
            "description": "Ollama Server for Room Mapping"
        },
        {
            "id": "room_mapping",
            "node": "agx2",
            "command": "source .venv/bin/activate && python3 run_llm_with_web.py",
            "cwd": "/home/nvidia/GIT/TheAgency/src/room_mapping",
            "description": "Room Mapping Logic"
        },
        {
            "id": "test_ping",
            "node": "laptop",
            "command": "ping -c 10 google.com",
            "cwd": "/tmp",
            "description": "Test connectivity from Laptop"
        }
    ]
}